{
  "name": "dispatch-starter",
  "version": "0.1.0",
  "description": "Same-day batched delivery platform: runnable starter (API, SQLite, pricing, batching, simulator).",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "DEV=1 node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "simulate": "node --disable-warning=ExperimentalWarning scripts/simulate.js",
    "new-region": "node scripts/new-region.js"
  }
}
